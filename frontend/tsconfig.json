{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "baseUrl": "./src",
    "paths": {
      "components": ["./components"],
      "containers": ["./containers"],
      "constants": ["./constants"],
      "hooks": ["./hooks"],
      "interfaces": ["//interfaces"],
      "routes": ["./routes"],
      "services": ["./services"],
      "slices": ["./slices"],
      "store": ["./store"],
      "styles": ["./styles"],
      "types": ["./types"]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src"
  ]
}
